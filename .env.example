# Generate with: npx tsx scripts/auth/hash-password.ts "your-password"
SITE_PASSWORD_HASH=

# Random 32+ byte secret (e.g. openssl rand -base64 32)
AUTH_SECRET=

# Rime TTS API key (https://app.rime.ai). Required at request time for audio
# generation; not needed for `npm run check` (tests mock the Rime adapter).
RIME_API_KEY=

# Vercel Blob read/write token. Required at request time for audio storage;
# not needed for `npm run check` (tests mock the Blob adapter).
BLOB_READ_WRITE_TOKEN=
